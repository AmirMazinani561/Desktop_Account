// =============================================================================
//  schema.prisma — فاز ۰: زیرساخت، امنیت و موتور مالی یکپارچه
//  سند بالادستی: DATA_MODEL.md نسخه ۰.۲ (تأییدشده) • PRD.md نسخه ۰.۳
// =============================================================================
//  دامنهٔ این فایل (عمداً محدود):
//    ۱) احراز هویت و چندکاربره  ۲) موتور سند (Journal/JournalLine)
//    ۳) حساب‌ها و طرف‌حساب‌ها     ۴) سال/دورهٔ مالی
//    ۵) مانده‌های دوره‌ای و شماره‌گذاری  ۶) یکپارچه‌سازی (منبع خارجی)
//    ۷) پیوست، بکاپ، مهاجرت، ممیزی
//  موجودیت‌های فاز ۱ (دوره‌ای/بودجه/وام/پیامک) و فاز ۲/۳/۴ در مهاجرت‌های
//  بعدی و به‌صورت **افزودنی** اضافه می‌شوند (طبق DATA_MODEL.md بندهای ۵، ۷، ۸، ۹).
//
//  تقسیم مسئولیت با SQL (بسیار مهم):
//    - این فایل: جدول‌ها، ستون‌ها، نوع‌ها، کلیدهای خارجی، ایندکس‌های ساده و یونیک کامل.
//    - فایل `db/sql/0001_core_constraints_and_triggers.sql`:
//        قیدهای CHECK، ایندکس‌های یونیک **partial/exprissional**، تریگرهای تضمین تراز
//        و تغییرناپذیری، توابع شماره‌گذاری، و viewها.
//      دلیل: Prisma این موارد را تولید نمی‌کند (جزئیات در db/README.md).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUM ها — نام نوع در Postgres دقیقاً برابر نام enum زیر است (با حروف بزرگ)
// و در SQL باید داخل گیومهٔ دوتایی نوشته شود، مثلاً "JournalStatus"
// -----------------------------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum RoleKind {
  OWNER
  ACCOUNTANT
  VIEWER
}

enum ActorKind {
  USER
  SYSTEM
  EXTERNAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST
  VOID
  LOGIN
  LOGIN_FAILED
  LOGOUT
  EXPORT
  IMPORT
  RESTORE
  TOKEN_ISSUED
  RECONCILE_MISMATCH
}

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountKind {
  BANK
  CASH
  PERSON
  INCOME_HEADING
  EXPENSE_HEADING
  CONTROL
  OTHER
}

enum DetailType {
  FIXED
  FLOATING
}

enum CounterpartyType {
  NATURAL
  LEGAL
}

enum FiscalYearStatus {
  OPEN
  CLOSED
  LOCKED
}

enum FiscalPeriodStatus {
  OPEN
  SOFT_CLOSED
  LOCKED
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum JournalKind {
  TRANSACTION
  RECURRING
  SMS
  IMPORT
  MANUAL
  INVOICE
  CHECK
  PAYROLL
  OPENING
  CLOSING
  ADJUSTMENT
  PRODUCTION
}

/// منبع سازندهٔ سند — کلید ضدتکرار روی (source_type, source_id) در SQL ساخته می‌شود
enum JournalSourceType {
  MANUAL
  RECURRING_RUN
  SMS_MESSAGE
  EXTERNAL_TRANSACTION
  INVOICE
  CHECK
  IMPORT_JOB
  LOAN_INSTALLMENT
  PRODUCTION_ORDER
}

enum LineSide {
  DEBIT
  CREDIT
}

/// نقش سطر — «نمای تراکنش ساده» و گزارش‌های تفکیکی به آن تکیه می‌کنند (DATA_MODEL بند ۴.۵)
enum LineRole {
  SOURCE
  DESTINATION
  FEE
  PRINCIPAL
  INTEREST
  TAX
  DISCOUNT
  COGS
  MAIN
}

enum SerialKind {
  JOURNAL
  INVOICE_SALES
  INVOICE_PURCHASE
  CHECK_RECEIVABLE
  CHECK_PAYABLE
  STOCK_MOVE
  PRODUCTION_ORDER
}

enum AttachmentOwnerType {
  JOURNAL
  INVOICE
  CHECK
  SMS_MESSAGE
  PRODUCT
  COUNTERPARTY
  OTHER
}

enum StorageKind {
  OBJECT_STORAGE
  LOCAL
}

enum BackupKind {
  MANUAL
  SCHEDULED
}

enum ImportSource {
  WALLET_V2_BACKUP
  APP_BACKUP
  EXCEL
  EXTERNAL_SOURCE
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  DRY_RUN
  COMMITTED
  FAILED
  ROLLED_BACK
}

enum ExternalKind {
  WALLET
  BANK_AGGREGATOR
  MARKETPLACE
  OTHER
}

/// تصمیم قطعی کارفرما (۱۴۰۵/۰۶/۲۳): لینک کیف پول **یک‌طرفه** است → فقط INBOUND
enum ExternalDirection {
  INBOUND
  OUTBOUND
  BOTH
}

enum ExternalAuthKind {
  BEARER_TOKEN
  HMAC
}

enum ExternalTxStatus {
  RECEIVED
  MAPPED
  POSTED
  DUPLICATE
  REJECTED
  NEEDS_REVIEW
}

enum ExternalTxDirection {
  INCOME
  EXPENSE
  TRANSFER
}

enum MappedBy {
  RULE
  MANUAL
}

enum MatchKind {
  KEYWORD
  REGEX
  SENDER
  SOURCE_ACCOUNT
  AMOUNT_RANGE
  DEFAULT
}

// =============================================================================
//  ۱) فاز ۰ — احراز هویت، نقش‌ها و چندمجموعه‌پذیری (DATA_MODEL بند ۳)
// =============================================================================

model Company {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(200)
  legalName    String?       @map("legal_name") @db.VarChar(300)
  nationalId   String?       @map("national_id") @db.VarChar(20)
  economicCode String?       @map("economic_code") @db.VarChar(20)
  /// واحد نمایش مبلغ — تصمیم قطعی کارفرما: ریال (ذخیرهٔ پول همیشه ریالِ صحیح است)
  baseUnit     String        @default("RIAL") @map("base_unit") @db.VarChar(10)
  calendar     String        @default("JALALI") @db.VarChar(10)
  status       CompanyStatus @default(ACTIVE)
  ownerUserId  String        @map("owner_user_id") @db.Uuid
  owner        User          @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships          Membership[]
  accounts             Account[]
  counterparties       Counterparty[]
  fiscalYears          FiscalYear[]
  fiscalPeriods        FiscalPeriod[]
  journals             Journal[]
  journalLines         JournalLine[]
  serialCounters       SerialCounter[]
  accountBalances      AccountPeriodBalance[]
  attachments          Attachment[]
  backupSnapshots      BackupSnapshot[]
  importJobs           ImportJob[]
  auditLogs            AuditLog[]
  settings             Setting[]
  externalSources      ExternalSource[]
  externalTransactions ExternalTransaction[]
  mappingRules         AccountMappingRule[]

  @@unique([nationalId])
  @@index([status])
  @@index([ownerUserId])
  @@map("companies")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @db.VarChar(320)
  /// توسط تریگر `fn_users_email_lower` از `email` پر می‌شود؛ یونیک بودن روی این ستون است
  emailLower        String     @map("email_lower") @db.VarChar(320)
  phone             String?    @db.VarChar(20)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  displayName       String     @map("display_name") @db.VarChar(120)
  locale            String     @default("fa") @db.VarChar(10)
  status            UserStatus @default(ACTIVE)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  /// حذف منطقی کاربر، ایمیل او را آزاد نمی‌کند (تصمیم عمدی: جلوگیری از جعل هویت مجدد)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownedCompanies     Company[]      @relation("CompanyOwner")
  memberships        Membership[]   @relation("MembershipUser")
  invitedMemberships Membership[]   @relation("MembershipInviter")
  sessions           Session[]
  createdAccounts    Account[]      @relation("AccountCreator")
  createdJournals    Journal[]      @relation("JournalCreator")
  postedJournals     Journal[]      @relation("JournalPoster")
  voidedJournals     Journal[]      @relation("JournalVoider")
  auditLogs          AuditLog[]     @relation("AuditActor")
  createdSources     ExternalSource[]     @relation("ExternalSourceCreator")
  createdRules       AccountMappingRule[] @relation("MappingRuleCreator")
  createdImports     ImportJob[]          @relation("ImportCreator")
  createdBackups     BackupSnapshot[]     @relation("BackupCreator")

  @@unique([emailLower])
  @@unique([phone])
  @@index([status])
  @@map("users")
}

/// عضویت یک کاربر در یک مجموعه با یک نقش. `roleId` از فاز ۰ خالی است و
/// در فاز ۳ با جدول نقش‌های سفارشی پر می‌شود (بدون نیاز به مهاجرت ساختاری).
model Membership {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleKind  RoleKind  @map("role_kind")
  roleId    String?   @map("role_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  invitedBy String?   @map("invited_by") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user    User    @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inviter User?   @relation("MembershipInviter", fields: [invitedBy], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([companyId, userId])
  @@index([userId, isActive])
  @@map("memberships")
}

/// نشست سمت سرور — فقط **هش** توکن ذخیره می‌شود (DATA_MODEL بند ۳.۴)
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  companyId String?   @map("company_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip        String?   @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([tokenHash])
  @@index([userId, expiresAt])
  @@map("sessions")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  key       String   @db.VarChar(80)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([companyId, key])
  @@map("settings")
}

/// ردپای تغییرات — فقط‌افزودنی. `before`/`after` **پس از redaction** ذخیره می‌شوند.
model AuditLog {
  id               String      @id @default(uuid()) @db.Uuid
  companyId        String?     @map("company_id") @db.Uuid
  actorKind        ActorKind   @map("actor_kind")
  actorUserId      String?     @map("actor_user_id") @db.Uuid
  externalSourceId String?     @map("external_source_id") @db.Uuid
  action           AuditAction
  entityType       String      @map("entity_type") @db.VarChar(40)
  entityId         String?     @map("entity_id") @db.Uuid
  before           Json?
  after            Json?
  ip               String?     @db.VarChar(45)
  userAgent        String?     @map("user_agent") @db.VarChar(300)
  requestId        String?     @map("request_id") @db.VarChar(64)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  company        Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  actor          User?           @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  externalSource ExternalSource? @relation("AuditSource", fields: [externalSourceId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, entityType, entityId])
  @@index([externalSourceId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// =============================================================================
//  ۲) موتور مالی — حساب، طرف‌حساب، دورهٔ مالی، سند و آرتیکل (DATA_MODEL بند ۴)
// =============================================================================

model Account {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  parentId      String?      @map("parent_id") @db.Uuid
  /// مسیر متریالایز مثل `/uuid1/uuid2/` — توسط تریگر `fn_accounts_tree` نگهداری می‌شود
  path          String       @db.VarChar(1000)
  depth         Int          @default(1) @db.SmallInt
  accountClass  AccountClass @map("account_class")
  accountKind   AccountKind  @map("account_kind")
  /// کدینگ کامل (گروه/کل/معین/تفصیلی) در فاز ۳ پر می‌شود
  code          String?      @db.VarChar(30)
  codingLevel   Int?         @map("coding_level") @db.SmallInt
  detailType    DetailType?  @map("detail_type")
  isPostable    Boolean      @default(true) @map("is_postable")
  name          String       @db.VarChar(120)
  icon          String?      @db.VarChar(40)
  color         String?      @db.VarChar(20)
  isFavorite    Boolean      @default(false) @map("is_favorite")
  openingBalance BigInt      @default(0) @map("opening_balance")
  openingSide   LineSide     @default(DEBIT) @map("opening_side")
  counterpartyId String?     @map("counterparty_id") @db.Uuid
  bankName      String?      @map("bank_name") @db.VarChar(80)
  bankAccountNo String?      @map("bank_account_no") @db.VarChar(40)
  cardNoLast4   String?      @map("card_no_last4") @db.VarChar(4)
  isSystem      Boolean      @default(false) @map("is_system")
  isActive      Boolean      @default(true) @map("is_active")
  archivedAt    DateTime?    @map("archived_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String       @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company           Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent            Account?   @relation("AccountParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children          Account[]  @relation("AccountParent")
  creator           User       @relation("AccountCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  counterparty      Counterparty? @relation("AccountCounterparty", fields: [counterpartyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  journalLines      JournalLine[]
  balances          AccountPeriodBalance[]
  linkedCounterparties Counterparty[] @relation("CounterpartyLinkedAccount")
  mappingRuleDebits AccountMappingRule[] @relation("MappingRuleDebit")
  mappingRuleCredits AccountMappingRule[] @relation("MappingRuleCredit")
  mappedExternalTxs ExternalTransaction[] @relation("ExternalTxMappedAccount")

  // یونیک بودن `code` عمداً اینجا @@unique نشده: نسخهٔ partial و نرم‌حذف‌آگاه
  // (`ux_accounts_code`) در db/sql/0001_core_constraints_and_triggers.sql ساخته می‌شود
  // تا کد یک حساب حذف‌شده (منطقی) دوباره قابل استفاده باشد.
  @@index([companyId, parentId])
  @@index([companyId, path])
  @@index([companyId, accountClass, isActive])
  @@index([companyId, accountKind])
  @@index([counterpartyId])
  @@index([createdBy])
  @@map("accounts")
}

model Counterparty {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  type            CounterpartyType
  name            String           @db.VarChar(200)
  nationalId      String?          @map("national_id") @db.VarChar(20)
  companyRegNo    String?          @map("company_reg_no") @db.VarChar(30)
  economicCode    String?          @map("economic_code") @db.VarChar(20)
  phone           String?          @db.VarChar(20)
  email           String?          @db.VarChar(320)
  address         String?          @db.VarChar(500)
  postalCode      String?          @map("postal_code") @db.VarChar(12)
  /// سقف اعتبار — فاز ۲
  creditLimit     BigInt?          @map("credit_limit")
  paymentTermsDays Int?            @map("payment_terms_days")
  linkedAccountId String?          @map("linked_account_id") @db.Uuid
  notes           String?          @db.VarChar(1000)
  isActive        Boolean          @default(true) @map("is_active")
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  linkedAccount Account?      @relation("CounterpartyLinkedAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  accounts      Account[]     @relation("AccountCounterparty")
  journalLines  JournalLine[]

  @@unique([companyId, nationalId])
  @@unique([companyId, linkedAccountId])
  @@index([companyId, isActive, name])
  @@map("counterparties")
}

model FiscalYear {
  id         String           @id @default(uuid()) @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  jalaliYear Int              @map("jalali_year")
  title      String?          @db.VarChar(60)
  startDate  DateTime         @map("start_date") @db.Date
  endDate    DateTime         @map("end_date") @db.Date
  status     FiscalYearStatus @default(OPEN)
  openedBy   String?          @map("opened_by") @db.Uuid
  closedAt   DateTime?        @map("closed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  periods        FiscalPeriod[]
  journals       Journal[]
  serialCounters SerialCounter[]

  @@unique([companyId, jalaliYear])
  @@index([companyId, status])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id           String             @id @default(uuid()) @db.Uuid
  companyId    String             @map("company_id") @db.Uuid
  fiscalYearId String             @map("fiscal_year_id") @db.Uuid
  periodIndex  Int                @map("period_index") @db.SmallInt
  jalaliYear   Int                @map("jalali_year")
  jalaliMonth  Int                @map("jalali_month") @db.SmallInt
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  status       FiscalPeriodStatus @default(OPEN)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company                @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fiscalYear   FiscalYear             @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  journals     Journal[]
  journalLines JournalLine[]
  balances     AccountPeriodBalance[]

  @@unique([fiscalYearId, periodIndex])
  @@unique([companyId, jalaliYear, jalaliMonth])
  @@index([companyId, fiscalYearId])
  @@map("fiscal_periods")
}

model Journal {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  fiscalYearId     String            @map("fiscal_year_id") @db.Uuid
  fiscalPeriodId   String            @map("fiscal_period_id") @db.Uuid
  /// شمارهٔ سند — هنگام **ثبت** از `fn_next_serial` گرفته می‌شود (بی‌شکاف)
  serialNo         BigInt?           @map("serial_no")
  date             DateTime          @db.Date
  jalaliYear       Int               @map("jalali_year")
  jalaliMonth      Int               @map("jalali_month") @db.SmallInt
  jalaliDay        Int               @map("jalali_day") @db.SmallInt
  description      String?           @db.VarChar(500)
  kind             JournalKind
  status           JournalStatus     @default(DRAFT)
  /// توسط تریگر `fn_journal_lines_recompute_totals` نگهداری می‌شود — دستی ننویسید
  totalDebit       BigInt            @default(0) @map("total_debit")
  totalCredit      BigInt            @default(0) @map("total_credit")
  lineCount        Int               @default(0) @map("line_count") @db.SmallInt
  refNo            String?           @map("ref_no") @db.VarChar(60)
  refKind          String?           @map("ref_kind") @db.VarChar(20)
  sourceType       JournalSourceType? @map("source_type")
  sourceId         String?           @map("source_id") @db.Uuid
  reverseOfJournalId String?         @map("reverse_of_journal_id") @db.Uuid
  attachmentCount  Int               @default(0) @map("attachment_count") @db.SmallInt
  createdBy        String            @map("created_by") @db.Uuid
  postedBy         String?           @map("posted_by") @db.Uuid
  postedAt         DateTime?         @map("posted_at") @db.Timestamptz(6)
  voidedBy         String?           @map("voided_by") @db.Uuid
  voidedAt         DateTime?         @map("voided_at") @db.Timestamptz(6)
  voidReason       String?           @map("void_reason") @db.VarChar(500)
  /// فقط سند DRAFT قابل حذف منطقی است (قید در SQL + تریگر)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fiscalYear      FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fiscalPeriod    FiscalPeriod   @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator         User           @relation("JournalCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  poster          User?          @relation("JournalPoster", fields: [postedBy], references: [id], onDelete: SetNull, onUpdate: Restrict)
  voider          User?          @relation("JournalVoider", fields: [voidedBy], references: [id], onDelete: SetNull, onUpdate: Restrict)
  reverseOf       Journal?       @relation("JournalReversal", fields: [reverseOfJournalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversals       Journal[]      @relation("JournalReversal")
  lines           JournalLine[]
  externalTx      ExternalTransaction[] @relation("ExternalTxJournal")

  @@index([companyId, fiscalYearId, serialNo])
  @@index([companyId, status, date(sort: Desc)])
  @@index([companyId, fiscalPeriodId])
  @@index([companyId, kind, createdAt(sort: Desc)])
  @@index([companyId, refNo])
  @@index([createdBy])
  @@index([reverseOfJournalId])
  @@map("journals")
}

model JournalLine {
  id             String     @id @default(uuid()) @db.Uuid
  journalId      String     @map("journal_id") @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  lineNo         Int        @map("line_no") @db.SmallInt
  accountId      String     @map("account_id") @db.Uuid
  side           LineSide
  /// مبلغ همیشه **مثبت** و به ریال؛ علامت از `side` و طبیعت حساب مشتق می‌شود
  amount         BigInt
  lineRole       LineRole   @default(MAIN) @map("line_role")
  description    String?    @db.VarChar(500)
  counterpartyId String?    @map("counterparty_id") @db.Uuid
  /// denormalized برای گزارش‌گیری سریع (بدون join به سند)
  fiscalPeriodId String     @map("fiscal_period_id") @db.Uuid
  jalaliYear     Int        @map("jalali_year")
  jalaliMonth    Int        @map("jalali_month") @db.SmallInt
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  journal      Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fiscalPeriod FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([journalId, lineNo])
  @@index([companyId, accountId, jalaliYear, jalaliMonth])
  @@index([companyId, fiscalPeriodId, accountId])
  @@index([companyId, counterpartyId])
  @@map("journal_lines")
}

/// شمارندهٔ شمارهٔ اسناد/فاکتور/چک — شماره‌گذاری **بی‌شکاف** با قفل سطری
model SerialCounter {
  companyId    String     @map("company_id") @db.Uuid
  fiscalYearId String     @map("fiscal_year_id") @db.Uuid
  kind         SerialKind
  lastNo       BigInt     @default(0) @map("last_no")
  prefix       String?    @db.VarChar(10)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([companyId, fiscalYearId, kind])
  @@map("serial_counters")
}

/// اسنپ‌شات ماندهٔ هر حساب در هر دوره — لایهٔ سریع گزارش‌ها (DATA_MODEL بند ۴.۸)
model AccountPeriodBalance {
  companyId       String   @map("company_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  fiscalPeriodId  String   @map("fiscal_period_id") @db.Uuid
  jalaliYear      Int      @map("jalali_year")
  jalaliMonth     Int      @map("jalali_month") @db.SmallInt
  openingDebit    BigInt   @default(0) @map("opening_debit")
  openingCredit   BigInt   @default(0) @map("opening_credit")
  periodDebit     BigInt   @default(0) @map("period_debit")
  periodCredit    BigInt   @default(0) @map("period_credit")
  closingDebit    BigInt   @default(0) @map("closing_debit")
  closingCredit   BigInt   @default(0) @map("closing_credit")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([companyId, accountId, fiscalPeriodId])
  @@index([companyId, jalaliYear, jalaliMonth])
  @@map("account_period_balances")
}

model Attachment {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  /// polymorphic — کلید خارجی در سطح دیتابیس ندارد (یکپارچگی در لایهٔ اپلیکیشن + تست)
  ownerType     AttachmentOwnerType @map("owner_type")
  ownerId       String              @map("owner_id") @db.Uuid
  fileName      String              @map("file_name") @db.VarChar(255)
  storageKind   StorageKind         @map("storage_kind")
  storageKey    String              @map("storage_key") @db.VarChar(500)
  mimeType      String?             @map("mime_type") @db.VarChar(120)
  sizeBytes     BigInt?             @map("size_bytes")
  sha256        String?             @db.Char(64)
  uploadedBy    String?             @map("uploaded_by") @db.Uuid
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([companyId, ownerType, ownerId])
  @@index([companyId, sha256])
  @@map("attachments")
}

model BackupSnapshot {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  kind            BackupKind
  storageKey      String     @map("storage_key") @db.VarChar(500)
  sha256          String     @db.Char(64)
  sizeBytes       BigInt     @map("size_bytes")
  format          String     @default("JSON") @db.VarChar(10)
  schemaVersion   String     @map("schema_version") @db.VarChar(12)
  rowCounts       Json?      @map("row_counts")
  /// هش ماندهٔ همهٔ حساب‌ها — مغایرت‌گیری پس از بازیابی
  balanceChecksum String?    @map("balance_checksum") @db.VarChar(64)
  status          String     @default("CREATED") @db.VarChar(12)
  createdBy       String?    @map("created_by") @db.Uuid
  restoredAt      DateTime?  @map("restored_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator User?   @relation("BackupCreator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([companyId, createdAt(sort: Desc)])
  @@map("backup_snapshots")
}

/// مهاجرت از نسخهٔ قدیم، ورود Excel و بازیابی بکاپ (DATA_MODEL بند ۵.۶ و ۱۱)
model ImportJob {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  source         ImportSource
  fileName       String?      @map("file_name") @db.VarChar(255)
  sha256         String?      @db.Char(64)
  schemaVersion  String?      @map("schema_version") @db.VarChar(12)
  status         ImportStatus @default(UPLOADED)
  /// برچسب همهٔ رکوردهای ساخته‌شده → رول‌بک دقیق
  batchTag       String?      @map("batch_tag") @db.VarChar(36)
  stats          Json?
  errorReport    Json?        @map("error_report")
  reconciliation Json?
  createdBy      String?      @map("created_by") @db.Uuid
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?    @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator User?   @relation("ImportCreator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([batchTag])
  @@index([companyId, status])
  @@map("import_jobs")
}

// =============================================================================
//  ۳) یکپارچه‌سازی — لینک یک‌طرفهٔ کیف پول هوشمند (DATA_MODEL بند ۶)
// =============================================================================

model ExternalSource {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  name            String            @db.VarChar(80)
  kind            ExternalKind
  /// تصمیم قطعی: یک‌طرفه → در عمل همیشه INBOUND
  direction       ExternalDirection @default(INBOUND)
  authKind        ExternalAuthKind  @map("auth_kind")
  tokenHash       String?           @map("token_hash") @db.VarChar(64)
  hmacSecretEnc   Bytes?            @map("hmac_secret_enc")
  scopes          Json?
  allowedCidrs    Json?             @map("allowed_cidrs")
  rateLimitPerMin Int               @default(60) @map("rate_limit_per_min")
  lastSeenAt      DateTime?         @map("last_seen_at") @db.Timestamptz(6)
  lastError       String?           @map("last_error") @db.VarChar(500)
  isActive        Boolean           @default(true) @map("is_active")
  createdBy       String            @map("created_by") @db.Uuid
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator      User                 @relation("ExternalSourceCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions ExternalTransaction[]
  mappingRules AccountMappingRule[]
  auditLogs    AuditLog[]           @relation("AuditSource")

  @@index([companyId, isActive])
  @@unique([tokenHash])
  @@index([createdBy])
  @@map("external_sources")
}

/// صندوق ورود تراکنش‌های خارجی — payload خام تغییرناپذیر + کلید ضدتکرار
model ExternalTransaction {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  externalSourceId String              @map("external_source_id") @db.Uuid
  externalId       String              @map("external_id") @db.VarChar(80)
  idempotencyKey   String              @map("idempotency_key") @db.VarChar(160)
  rawPayload       Json                @map("raw_payload")
  occurredAt       DateTime            @map("occurred_at") @db.Timestamptz(6)
  jalaliYear       Int                 @map("jalali_year")
  jalaliMonth      Int                 @map("jalali_month") @db.SmallInt
  jalaliDay        Int                 @map("jalali_day") @db.SmallInt
  amount           BigInt
  direction        ExternalTxDirection
  sourceHint       String?             @map("source_hint") @db.VarChar(120)
  destinationHint  String?             @map("destination_hint") @db.VarChar(120)
  referenceNo      String?             @map("reference_no") @db.VarChar(60)
  description      String?             @db.VarChar(500)
  status           ExternalTxStatus    @default(RECEIVED)
  mappingRuleId    String?             @map("mapping_rule_id") @db.Uuid
  mappedAccountId  String?             @map("mapped_account_id") @db.Uuid
  mappedBy         MappedBy?           @map("mapped_by")
  journalId        String?             @map("journal_id") @db.Uuid
  errorMessage     String?             @map("error_message")
  receivedAt       DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime?           @map("processed_at") @db.Timestamptz(6)

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  source       ExternalSource    @relation(fields: [externalSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mappingRule  AccountMappingRule? @relation("MappingRuleApplied", fields: [mappingRuleId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  mappedAccount Account?         @relation("ExternalTxMappedAccount", fields: [mappedAccountId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  journal      Journal?          @relation("ExternalTxJournal", fields: [journalId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([companyId, idempotencyKey])
  @@index([externalSourceId, status])
  @@index([companyId, occurredAt(sort: Desc)])
  @@index([companyId, status])
  @@map("external_transactions")
}

model AccountMappingRule {
  id                  String     @id @default(uuid()) @db.Uuid
  companyId           String     @map("company_id") @db.Uuid
  /// NULL یعنی قاعدهٔ سراسری (برای همهٔ منابع این مجموعه)
  externalSourceId    String?    @map("external_source_id") @db.Uuid
  matchKind           MatchKind  @map("match_kind")
  matchValue          String?    @map("match_value") @db.VarChar(300)
  priority            Int        @default(100) @db.SmallInt
  debitAccountId      String     @map("debit_account_id") @db.Uuid
  creditAccountId     String     @map("credit_account_id") @db.Uuid
  descriptionTemplate String?    @map("description_template") @db.VarChar(500)
  isActive            Boolean    @default(true) @map("is_active")
  hitCount            Int        @default(0) @map("hit_count")
  createdBy           String     @map("created_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  externalSource     ExternalSource?       @relation(fields: [externalSourceId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  debitAccount       Account               @relation("MappingRuleDebit", fields: [debitAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creditAccount      Account               @relation("MappingRuleCredit", fields: [creditAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator            User                  @relation("MappingRuleCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  externalTransactions ExternalTransaction[] @relation("MappingRuleApplied")

  @@index([companyId, isActive, priority])
  @@index([externalSourceId])
  @@index([createdBy])
  @@map("account_mapping_rules")
}
